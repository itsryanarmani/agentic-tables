{
  "name": "agentic-tables",
  "version": "0.15.2",
  "description": "Typed tables that agents read and write as rows.",
  "keywords": [
    "database",
    "tables",
    "airtable",
    "rows",
    "schema",
    "agents",
    "mcp",
    "cli",
    "structured-data"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-tables.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "ui-dist",
    "llms.txt",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-tables",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./file-store": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/embed.css",
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "scripts": {
    "build": "tsup && npm run build:ui",
    "deploy:demo": "npm run build && wrangler deploy --config wrangler.demo.jsonc",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "npm run dev",
    "test:e2e": "playwright test",
    "test:firestore": "npx -y firebase-tools@14 emulators:exec --only firestore --project agentic-tables-e2e \"vitest run src/node.e2e.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist ui-dist",
    "prepack": "npm run build",
    "ci:local": "npm run build && npm run typecheck && npm test",
    "dev": "npm run build:ui && WRANGLER_SEND_METRICS=false wrangler dev --var AGENTIC_TABLES_LOCAL_DEV:1 --var AGENTIC_TABLES_REGION:eu",
    "dev:smoke": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agentic-design": ">=0.8.0 <1.0.0",
    "agentic-identity": ">=0.10.0 <1.0.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "agentic-design-latest": "npm:agentic-design@0.10.1",
    "agentic-identity-latest": "npm:agentic-identity@^0.12.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20261023.2-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "bin": {
    "agentic-tables": "./dist/cli.js",
    "agentic-tables-mcp": "./dist/mcp-bin.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "agentic-design": {
      "zod": "^4.6.7"
    }
  }
}
